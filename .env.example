# Required admin (first boot)
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=StrongPasswordHere123!

# Public hostname (Railway will give you one, or use custom domain)
DISCOURSE_HOSTNAME=your-service.up.railway.app

# Database (add a Postgres service and use reference variables)
DISCOURSE_DB_HOST=${{Postgres.PGHOST}}
DISCOURSE_DB_PORT=${{Postgres.PGPORT}}
DISCOURSE_DB_NAME=${{Postgres.PGDATABASE}}
DISCOURSE_DB_USERNAME=${{Postgres.PGUSER}}
DISCOURSE_DB_PASSWORD=${{Postgres.PGPASSWORD}}

# Redis (add a Redis service)
DISCOURSE_REDIS_HOST=${{Redis.REDISHOST}}
DISCOURSE_REDIS_PORT=${{Redis.REDISPORT}}
DISCOURSE_REDIS_PASSWORD=${{Redis.REDISPASSWORD}}

# SMTP - start with a real provider or Mailpit for testing
DISCOURSE_SMTP_ADDRESS=smtp.resend.com
DISCOURSE_SMTP_PORT=587
DISCOURSE_SMTP_USER_NAME=resend
DISCOURSE_SMTP_PASSWORD=your-api-key
DISCOURSE_SMTP_ENABLE_START_TLS=true

DISCOURSE_FORCE_HTTPS=true
DISCOURSE_SECRET_KEY_BASE=generate-a-long-random-string-at-least-128-chars
